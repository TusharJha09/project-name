<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Snake & Ladder Game</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #667eea, #764ba2);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .game {
            background: white;
            padding: 20px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            text-align: center;
        }

        h1 {
            color: #333;
            margin-top: 0;
        }

        #board {
            width: min(90vw, 600px);
            height: min(90vw, 600px);
            display: grid;
            grid-template-columns: repeat(10, 1fr);
            border: 4px solid #222;
            margin: 15px auto;
        }

        .cell {
            position: relative;
            border: 1px solid #777;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
            font-size: clamp(10px, 2vw, 16px);
        }

        .cell:nth-child(odd) {
            background: #ffe082;
        }

        .cell:nth-child(even) {
            background: #81d4fa;
        }

        .ladder {
            background: #a5d6a7 !important;
        }

        .snake {
            background: #ef9a9a !important;
        }

        .number {
            position: absolute;
            top: 2px;
            left: 4px;
            color: #333;
        }

        .players {
            position: absolute;
            bottom: 3px;
            display: flex;
            gap: 2px;
        }

        .player {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            border: 2px solid white;
        }

        .p1 {
            background: red;
        }

        .p2 {
            background: blue;
        }

        .controls {
            margin-top: 15px;
        }

        button {
            padding: 12px 25px;
            border: none;
            border-radius: 10px;
            background: #4caf50;
            color: white;
            font-size: 18px;
            cursor: pointer;
            margin: 5px;
        }

        button:hover {
            background: #388e3c;
        }

        button:disabled {
            background: #aaa;
            cursor: not-allowed;
        }

        #dice {
            font-size: 40px;
            margin: 10px;
        }

        #message {
            font-size: 18px;
            font-weight: bold;
            color: #333;
            min-height: 25px;
        }

        .legend {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 10px;
            font-size: 14px;
        }

        .red {
            color: red;
        }

        .green {
            color: green;
        }
    </style>
</head>

<body>

<div class="game">

    <h1>🐍 Snake & Ladder 🪜</h1>

    <div id="board"></div>

    <div id="dice">🎲</div>

    <div id="message">
        Player 1's turn
    </div>

    <div class="controls">
        <button id="rollBtn" onclick="rollDice()">
            Roll Dice
        </button>

        <button onclick="restartGame()">
            Restart
        </button>
    </div>

    <div class="legend">
        <span class="red">🔴 Player 1</span>
        <span class="green">🔵 Player 2</span>
    </div>

</div>


<script>

    const board = document.getElementById("board");
    const message = document.getElementById("message");
    const diceDisplay = document.getElementById("dice");
    const rollBtn = document.getElementById("rollBtn");

    // Snakes
    const snakes = {
        99: 54,
        70: 55,
        52: 42,
        25: 2
    };

    // Ladders
    const ladders = {
        4: 25,
        13: 46,
        33: 49,
        42: 63,
        62: 81,
        74: 92
    };

    let players = [
        {
            position: 1,
            className: "p1"
        },
        {
            position: 1,
            className: "p2"
        }
    ];

    let currentPlayer = 0;
    let gameOver = false;


    // Create board
    function createBoard() {

        board.innerHTML = "";

        // Create numbers 100 -> 1
        for (let row = 9; row >= 0; row--) {

            let start = row * 10 + 1;
            let numbers = [];

            for (let i = 0; i < 10; i++) {
                numbers.push(start + i);
            }

            // Alternate direction
            if ((9 - row) % 2 === 1) {
                numbers.reverse();
            }

            numbers.forEach(number => {

                const cell = document.createElement("div");

                cell.classList.add("cell");

                if (snakes[number]) {
                    cell.classList.add("snake");
                }

                if (ladders[number]) {
                    cell.classList.add("ladder");
                }

                cell.dataset.number = number;

                cell.innerHTML = `
                    <span class="number">${number}</span>
                    <div class="players"></div>
                `;

                board.appendChild(cell);
            });
        }

        updatePlayers();
    }


    // Update player positions
    function updatePlayers() {

        document.querySelectorAll(".players").forEach(container => {
            container.innerHTML = "";
        });

        players.forEach((player, index) => {

            const cell = document.querySelector(
                `[data-number="${player.position}"]`
            );

            if (cell) {

                const container = cell.querySelector(".players");

                const playerIcon = document.createElement("div");

                playerIcon.classList.add(
                    "player",
                    player.className
                );

                container.appendChild(playerIcon);
            }
        });
    }


    // Roll dice
    function rollDice() {

        if (gameOver) return;

        rollBtn.disabled = true;

        const dice = Math.floor(Math.random() * 6) + 1;

        diceDisplay.textContent = getDiceFace(dice);

        let player = players[currentPlayer];

        let newPosition = player.position + dice;

        // Cannot go beyond 100
        if (newPosition > 100) {

            message.textContent =
                `Player ${currentPlayer + 1} needs exactly the right number!`;

        } else {

            player.position = newPosition;

            // Ladder
            if (ladders[player.position]) {

                message.textContent =
                    `🪜 Player ${currentPlayer + 1} climbed a ladder!`;

                player.position = ladders[player.position];

            }

            // Snake
            else if (snakes[player.position]) {

                message.textContent =
                    `🐍 Player ${currentPlayer + 1} got bitten by a snake!`;

                player.position = snakes[player.position];

            }

            else {

                message.textContent =
                    `Player ${currentPlayer + 1} rolled ${dice}.`;
            }

            updatePlayers();

            // Check winner
            if (player.position === 100) {

                message.textContent =
                    `🎉 Player ${currentPlayer + 1} wins!`;

                gameOver = true;
                return;
            }
        }

        // Change player
        currentPlayer = currentPlayer === 0 ? 1 : 0;

        message.textContent +=
            ` Player ${currentPlayer + 1}'s turn.`;

        rollBtn.disabled = false;
    }


    // Dice faces
    function getDiceFace(number) {

        const faces = [
            "",
            "⚀",
            "⚁",
            "⚂",
            "⚃",
            "⚄",
            "⚅"
        ];

        return faces[number];
    }


    // Restart game
    function restartGame() {

        players = [
            {
                position: 1,
                className: "p1"
            },
            {
                position: 1,
                className: "p2"
            }
        ];

        currentPlayer = 0;
        gameOver = false;

        diceDisplay.textContent = "🎲";

        message.textContent = "Player 1's turn";

        rollBtn.disabled = false;

        createBoard();
    }


    // Start game
    createBoard();

</script>

</body>
</html>
